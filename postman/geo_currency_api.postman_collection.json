{"info": {"name": "Geo Currency API", "_postman_id": "geo-currency-api-collection", "description": "Postman collection for Geo Currency API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"}, "item": [{"name": "Create Country", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  "name": "France",\n  "isoCode": "FR",\n  "currencies": [\n    {\n      "code": "EUR",\n      "name": "Euro",\n      "isActive": true\n    }\n  ],\n  "isActive": true\n}"}, "url": {"raw": "http://localhost:3000/countries", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["countries"]}}}, {"name": "Get All Countries", "request": {"method": "GET", "url": {"raw": "http://localhost:3000/countries", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["countries"]}}}, {"name": "Update Country Status", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{"isActive": false}"}, "url": {"raw": "http://localhost:3000/countries/:id/status", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["countries", ":id", "status"]}}}, {"name": "Update Currency Status", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{"isActive": false}"}, "url": {"raw": "http://localhost:3000/countries/:countryId/currency/:code/status", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["countries", ":countryId", "currency", ":code", "status"]}}}]}